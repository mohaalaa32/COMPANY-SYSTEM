datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConversationStatus {
  AI_ACTIVE
  WAITING_STAFF
  STAFF_TAKEOVER
  RESOLVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageSender {
  CUSTOMER
  AI
  STAFF
  INTERNAL_NOTE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SENT_WHATSAPP
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
}

enum StaffRole {
  STAFF
  SUPERVISOR
}

enum KnowledgeCategory {
  FAQ
  OBJECTION_REPLY
  PRODUCT_NOTE
}

enum KnowledgeStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  WITHDRAWN
}

enum KnowledgeRevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Customer {
  id             String         @id @default(cuid())
  phone          String         @unique
  name           String
  city           String
  addressDetails String
  totalOrders    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  conversations  Conversation[]
  orders         Order[]

  @@map("customers")
}

model Conversation {
  id            String               @id @default(cuid())
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        ConversationStatus   @default(AI_ACTIVE)
  priority      ConversationPriority @default(NORMAL)
  assignedStaff String?
  summary       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  messages      Message[]
  toolAuditLogs ToolAuditLog[]
  outcome       ConversationOutcome?
  orders        Order[]

  @@index([customerId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String
  attachedCards  Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversationId      String?
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status              OrderStatus   @default(DRAFT)
  subtotalIQD         Int
  deliveryFeeIQD      Int           @default(0)
  totalAmountIQD      Int
  paymentMethod       PaymentMethod @default(CASH_ON_DELIVERY)
  idempotencyKey      String        @unique
  notes               String?
  conversationSummary String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  productNameAr String
  quantity      Int     @default(1)
  unitPriceIQD  Int
  subtotalIQD   Int

  @@index([orderId])
  @@map("order_items")
}

model ToolAuditLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName       String
  inputs         Json
  outputs        Json
  durationMs     Int
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([toolName])
  @@map("tool_audit_logs")
}

model ConversationOutcome {
  id                 String       @id @default(cuid())
  conversationId     String       @unique
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  category           String
  reason             String?
  satisfactionRating Int?
  notes              String?
  createdAt          DateTime     @default(now())

  @@map("conversation_outcomes")
}

model KnowledgeEntry {
  id               String              @id @default(cuid())
  category         KnowledgeCategory
  status           KnowledgeStatus     @default(DRAFT)
  titleAr          String
  contentAr        String
  triggerKeywords  String[]
  productIds       String[]
  branchId         String              @default("branch-karbala")
  publishedVersion Int                 @default(0)
  rejectionReason  String?
  createdById      String
  createdByNameAr  String
  createdByRole    StaffRole
  updatedById      String
  updatedByNameAr  String
  updatedByRole    StaffRole
  submittedById    String?
  submittedByNameAr String?
  submittedAt      DateTime?
  reviewedById     String?
  reviewedByNameAr String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  withdrawnById    String?
  withdrawnByNameAr String?
  withdrawnAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  revisions        KnowledgeRevision[]
  auditLogs        KnowledgeAuditLog[]
  sourceFeedbacks  AiReplyFeedback[]

  @@index([status])
  @@index([category])
  @@map("knowledge_entries")
}

model KnowledgeRevision {
  id                String                  @id @default(cuid())
  entryId           String
  entry             KnowledgeEntry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status            KnowledgeRevisionStatus @default(DRAFT)
  titleAr           String
  contentAr         String
  triggerKeywords   String[]
  productIds        String[]
  rejectionReason   String?
  createdById       String
  createdByNameAr   String
  createdByRole     StaffRole
  updatedById       String
  updatedByNameAr   String
  updatedByRole     StaffRole
  submittedById     String?
  submittedByNameAr String?
  submittedAt       DateTime?
  reviewedById      String?
  reviewedByNameAr  String?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([entryId, status])
  @@map("knowledge_revisions")
}

model KnowledgeAuditLog {
  id          String         @id @default(cuid())
  entryId     String
  entry       KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action      String
  actorId     String
  actorNameAr String
  actorRole   StaffRole
  fromStatus  String?
  toStatus    String?
  summaryAr   String
  reasonAr    String?
  createdAt   DateTime       @default(now())

  @@index([entryId])
  @@map("knowledge_audit_logs")
}

model AiReplyFeedback {
  id                     String             @id @default(cuid())
  conversationId         String
  messageId              String
  originalAiText         String
  correctedReplyAr       String
  notesAr                String?
  category               KnowledgeCategory?
  productIds             String[]
  linkedKnowledgeEntryId String?
  linkedKnowledgeEntry   KnowledgeEntry?    @relation(fields: [linkedKnowledgeEntryId], references: [id], onDelete: SetNull)
  createdById            String
  createdByNameAr        String
  createdByRole          StaffRole
  createdAt              DateTime           @default(now())

  @@index([conversationId])
  @@index([messageId])
  @@map("ai_reply_feedbacks")
}
