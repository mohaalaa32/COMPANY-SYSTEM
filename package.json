{
  "name": "tel-baghdad-ai-sales",
  "version": "0.1.0",
  "private": true,
  "description": "Tel Baghdad AI Sales Assistant — monorepo (see config/brand.ts for branding)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tel/backend --filter @tel/web dev",
    "dev:web": "pnpm --filter @tel/web dev",
    "dev:backend": "pnpm --filter @tel/backend dev",
    "build": "pnpm --filter @tel/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:calc": "pnpm --filter @tel/calc test",
    "test:adapters": "pnpm --filter @tel/adapters test",
    "test:e2e": "pnpm --filter @tel/web test:e2e",
    "eval": "pnpm --filter @tel/eval eval",
    "check:brand": "node scripts/check-brand.mjs",
    "verify": "pnpm check:brand && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @tel/db db:generate",
    "db:migrate": "pnpm --filter @tel/db db:migrate",
    "db:up": "docker compose up -d postgres redis"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
